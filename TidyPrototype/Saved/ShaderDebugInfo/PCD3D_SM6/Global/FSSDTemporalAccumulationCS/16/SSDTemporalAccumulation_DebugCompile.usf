	}


	float LobeSimilarity = 1;
	float AxesSimilarity = 1;
	if (BilateralSettings & (0x0020 | 0x0040))
	{
		const float Beta = 32;

		FSphericalGaussian Ref = ComputeRoughnessLobe(RefSceneMetadata);
